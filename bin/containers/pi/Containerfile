# NOTE: build this file
#
# >  podman build -t localhost/r2 ../r2
# >  podman build -t localhost/pi .

# Running it
#

# The -v "$PWD:/workspace" mounts your current directory into the container at
# /workspace such that reads and writes in /workspace inside the sandbox directly
# affect your host files

# Use a named volume for /root/.pi/agent if you want container-local settings
# and sessions.
# > podman run --rm -it -e ANTHROPIC_API_KEY -v "$PWD:/workspace" -v pi-agent-home:/root/.pi/agent localhost/pi
#
# Mounting your host ~/.pi.agent exposes host auth and session files to the container.
# > podman run --rm -it -v "$PWD:/workspace" -v ~/.pi.agent:/root/.pi/agent localhost/pi
# > podman run --rm -it -v "(pwd):/workspace" -v "('~/.pi.agent' | path expand):/root/.pi.agent" localhost/pi

FROM node:24-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates git fd-find bat fzf ripgrep python3 python3-pip python3-venv curl default-jdk-headless unzip wget build-essential binutils xxd file yara openssh-client iputils-ping nmap \
  && rm -rf /var/lib/apt/lists/*

# Install uv + uvx (Astral) via official image (no curl installer).
COPY --from=ghcr.io/astral-sh/uv:0.13.6 /uv /uvx /usr/local/bin/
# RUN echo '13a1f11b0b6fd0bb18b5798fe10043e5933d77a8e0e761a9926d7f3b2394b35a  /usr/local/bin/uv' | sha256sum -c - \
#   && echo 'f363fbc6d738584859dd52efd3bd8b7938c7aab5c989d920b4e8affc7966767d  /usr/local/bin/uvx' | sha256sum -c -
RUN uv tool install 'semble==0.5.2' \
  && uv tool install 'markitdown[all]==0.1.9' \
  && uv tool install 'git+https://github.com/mitsuhiko/pexpect-mcp@dff5d421490514fb35cc8891b85cfc90370d8119' \
  && ln -sf /root/.local/bin/* /usr/local/bin/

RUN wget -q https://github.com/rtk-ai/rtk/releases/download/v1.1.0/rtk-x86_64-unknown-linux-musl.tar.gz -O /tmp/rtk.tar.gz \
  && echo '9454ad1b9489daa57ab0a9f4ebe2faaf4dc82b8a0f26c9e5135151abd7c9378d  /tmp/rtk.tar.gz' | sha256sum -c - \
  && tar -xzf /tmp/rtk.tar.gz -C /usr/local/bin rtk \
  && rm /tmp/rtk.tar.gz

# Reuse prebuilt r2 + ghidra layer (build localhost/r2 first).
COPY --from=localhost/r2 /usr/local /usr/local
COPY --from=localhost/r2 /opt /opt

RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent tsx

# Post-run setup (do on host, not in image):
#   1. Generate a dedicated SSH key: ssh-keygen -t ed25519 -f ~/.ssh/pi_container -N ''
#   2. Add ~/.ssh/pi_container.pub to the target host/VM authorized_keys.
#   3. Create ~/.ssh/config entry: Host winhost / HostName ... / User ... / IdentityFile ~/.ssh/pi_container
# Run container with SSH access:
#   podman run --rm -it -v "$PWD:/workspace" -v ~/.ssh:/root/.ssh:ro localhost/pi
# Then inside pi: ssh winhost 'cargo build'

WORKDIR /workspace
ENTRYPOINT ["pi"]
